<truncated 19243 bytes>"'use client';\n\n/**\n * @module RolesHub\n * @description Main module for Roles Hub. Manages employee-station assignments and dynamically resolves operational activities based on global position rules.\n * @businessRules\n * - Store model toggle detects Drive-Thru vs Regular rules globally.\n * - Position rules map shifts and jobs to 6 canonical keys: MANAGER, ASSISTANT, SHIFT_LEADER_MALE, SHIFT_LEADER_FEMALE, COOK_MALE, CASHIER.\n * - Activity assignments are resolved in real-time, preventing data loss when employees rotate.\n * @dataFlow\n * - Reads stores from `stores`.\n * - Reads employees from `toast_employees` and jobs from `toast_jobs`.\n * - Reads weekly shift assignments from `shifts`.\n * - Manages grid assignments in `station_assignments`.\n * - Manages position mappings in `position_activities`.\n */\n\nimport React, { useState, useEffect, useMemo } from 'react';\nimport { createPortal } from 'react-dom';\nimport { useLanguage } from '@/lib/i18n';\nimport { createClient } from '@/lib/supabase-client';\nimport { motion, AnimatePresence } from 'framer-motion';\nimport { \n  Building2, \n  Users, \n  ChefHat, \n  Monitor, \n  ChevronLeft, \n  ChevronRight,\n  Save,\n  LayoutTemplate,\n  Zap,\n  CheckCircle2,\n  Copy,\n  PlusCircle,\n  Clock,\n  Trash2,\n  Loader2,\n  Sun,\n  Moon,\n  Phone,\n  UserMinus,\n  RefreshCw,\n  X,\n  ClipboardList,\n  Printer,\n  Search,\n  User,\n  Plus\n} from 'lucide-react';\nimport { format, startOfWeek, addDays, isSameDay, subDays } from 'date-fns';\nimport { es } from 'date-fns/locale';\nimport { getRoleWeight, getMonday, formatDateISO, formatStoreName } from '../planificador/lib/utils';\n\n// Helper to translate employee job + station group to the 6 standard roles\nconst resolvePositionKey = (employee: any, stationName: string, stationGroup: string, jobs: any[]): string => {\n  if (!employee) {\n    const s = (stationName || '').toLowerCase();\n    if (['tacos', 'carnes', 'burritos', 'preparacion', 'preparador', 'tortas/mulitas', 'tortas/quesadillas', 'tortillas', 'ta
